# Copy to `.env` and fill in ONE provider's credentials (or run `npm run setup`
# instead, which writes this file interactively). `.env` is gitignored.

# Which provider to use. If omitted, the first one with credentials present
# is used automatically (checked in order: azure, openai, gemini).
STT_PROVIDER=

# --- Option 1: Azure Speech (https://portal.azure.com) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Option 2: OpenAI Whisper (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=

# --- Option 3: Google Gemini (https://aistudio.google.com/apikey, free tier) ---
GEMINI_API_KEY=

# Optional shared-secret auth for the relay's HTTP API (recommended if your
# LAN isn't fully trusted). Leave blank to disable.
RELAY_TOKEN=
